# 默认：自动检测文本，统一以 LF 存储
* text=auto eol=lf

# Shell 脚本必须 LF，否则 Linux 上会报 "$'\r': command not found"
*.sh        text eol=lf
*.template  text eol=lf
*.bash      text eol=lf

# 文档 / 前端
*.md        text eol=lf
*.html      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.py        text eol=lf
.shellcheckrc text eol=lf
.gitignore    text eol=lf
.gitattributes text eol=lf

# Windows 批处理保留 CRLF
*.bat       text eol=crlf
*.cmd       text eol=crlf

# 二进制
*.png       binary
*.jpg       binary
*.gif       binary
*.gz        binary
*.zip       binary
